# Gateway
EIGENEAI_HOST=0.0.0.0
EIGENEAI_PORT=8080
EIGENEAI_DATA_DIR=./data
EIGENEAI_ADMIN_SECRET=change-me-admin-secret
EIGENEAI_PUBLIC_URL=https://eigeneai.local

# Inference backend (llama.cpp OpenAI-compatible server)
# Leave empty or set MOCK_INFERENCE=1 for CI/smoke without GPU
LLAMA_CPP_URL=http://127.0.0.1:8081
MOCK_INFERENCE=0

# Default model id (must match GGUF filename stem / llama.cpp --alias)
DEFAULT_MODEL=Qwen2.5-14B-Instruct-Q5_K_M
MODELS_DIR=/var/lib/ai/models

# Soft-reserve for Phase 2 multi-GPU (MVP uses 1)
GPU_COUNT=1
GPU_QUEUE_SIZE=32

# TLS termination is usually via nginx/caddy on the appliance;
# gateway itself can stay HTTP behind the reverse proxy.
